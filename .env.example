# nexo-mcp · variables de entorno (copiar a .env para local; NUNCA subir .env con valores reales)

# --- Servidor ---
NEXO_MCP_HOST=127.0.0.1                 # en el contenedor: 0.0.0.0 (lo pone el Dockerfile)
NEXO_MCP_PUERTO=8000
NEXO_MCP_URL_PUBLICA=https://<app>.<region>.azurecontainerapps.io   # sin /mcp
# NEXO_MCP_AUTH=desactivada             # SOLO en local (exige 127.0.0.1): sin Entra ID
NEXO_MCP_LIMITE_FILAS=1000

# --- Catálogo: manifest.json de dbt (uno de los dos) ---
# NEXO_MCP_MANIFEST=../nexo-dbt/target/manifest.json                 # local: tras «dbt parse»
NEXO_MCP_MANIFEST_URL=https://<cuenta>.blob.core.windows.net/<contenedor>/manifest.json
NEXO_MCP_MANIFEST_TTL=3600              # segundos entre recargas

# --- Base de datos NEXO ---
NEXO_PG_HOST=psql-neural-nexo-spc-prod.postgres.database.azure.com
NEXO_PG_DB=nexo
NEXO_PG_USER=<nombre de la identidad administrada en PostgreSQL>
NEXO_PG_AUTH=entra                      # entra (identidad administrada / az login) o password
# NEXO_PG_PASSWORD=                     # solo con NEXO_PG_AUTH=password
NEXO_PG_TIMEOUT_MS=15000

# --- Microsoft Entra ID (registro de aplicación «nexo-mcp») ---
NEXO_ENTRA_TENANT_ID=<id del tenant>
NEXO_ENTRA_CLIENT_ID=<id de cliente de la app nexo-mcp>
NEXO_ENTRA_APP_ID_URI=api://nexo-mcp
NEXO_ENTRA_SCOPE=Nexo.Leer              # permiso delegado expuesto por la app
NEXO_ENTRA_ROL=Nexo.Comite              # rol de aplicación asignado al grupo del comité
